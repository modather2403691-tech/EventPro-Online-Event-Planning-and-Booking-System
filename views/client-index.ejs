<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Client Home</title>
  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body>

<header>
  <nav class="home-navbar">
    <div class="home-logo">EventPro</div>

    <ul class="home-nav-links">
      <li><a href="/client-index">Home</a></li>
      <li><a href="/packages">Customize Your Packages</a></li>
      <li><a href="/client-profile">Profile</a></li>
    </ul>

    <div class="home-nav-actions">
      <a href="/logout" class="home-outline-btn">Logout</a>
    </div>
  </nav>
</header>

<main>
  <section class="hero-modern">
    <div class="hero-left">
      <h1>Welcome <%= name %></h1>
      <p class="hero-subtitle">
        Browse events, join activities, and manage your bookings easily with EventPro.
      </p>
      <ul class="hero-points">
        <li>Explore available events from organizers</li>
        <li>Join events and book services easily</li>
        <li>Track your bookings and schedules</li>
        <li>Manage your profile and preferences</li>
      </ul>
      <div class="hero-buttons">
      <a href="/packages" class="hero-primary-btn">Explore Packages</a>
      <a href="/packages" class="hero-secondary-btn">Book Now</a>
      
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-mockup">
        <div class="mockup-header">
          <span></span><span></span><span></span>
        </div>
        <div class="mockup-body">
          <div class="mockup-sidebar">
            <div class="mockup-line short"></div>
            <div class="mockup-line"></div>
            <div class="mockup-line"></div>
          </div>
          <div class="mockup-content">
            <div class="mockup-card large"></div>
            <div class="mockup-card-row">
              <div class="mockup-card small"></div>
              <div class="mockup-card small"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="floating-tag top-tag">My Bookings</div>
      <div class="floating-badge">✓</div>
    </div>
    <div class="hero-curve"></div>
  </section>

  <div class="search-filter-container container">
      <input type="text" id="eventSearch" placeholder="Search events by name... 🔍">
      <select id="typeFilter">
          <option value="all">All Types</option>
          <option value="corporate">Corporate</option>
          <option value="party">Parties</option>
      </select>
  </div>
  <section class="events-section">
    <h2>Explore Events</h2>

    <div class="events-grid">
      <% if (events && events.length) { %>
        <% events.forEach(event => { %>
          <div class="event-card" data-category="<%= event.category %>">
            <img src="<%= event.image ? event.image : '/images/event1.jpg' %>" alt="Event">
            <h3><%= event.title %></h3>
            <p><%= event.date ? event.date.toISOString().slice(0, 10) : 'Date TBD' %></p>
            <p><%= event.location %></p>
            <p class="event-price">$<%= event.price %> · by <%= event.organizerName %></p>
            <a href="/book-event?source=event&eventId=<%= event._id %>&event=<%= encodeURIComponent(event.title) %>&price=<%= event.price %>"><button>Join Event</button></a>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted">No events available yet. Check back soon!</p>
      <% } %>
    </div>
  </section>
</main>

<script src="/js/darkmode.js"></script>
<script src="/js/client&homepages&footer.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

