<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Client Home</title>
  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
</head>
<body>

<header>
  <nav class="home-navbar">
    <div class="home-logo">EventPro</div>

    <ul class="home-nav-links">
      <li><a href="/client-index">Home</a></li>
      <li><a href="/packages">Customize Your Packages</a></li>
      <li><a href="/my-bookings">My Bookings</a></li>
      <li><a href="/client-dashboard">Dashboard</a></li>
      <li><a href="/client-profile">Profile</a></li>
    </ul>

    <div class="home-nav-actions">
      <a href="/logout" class="home-outline-btn">Logout</a>
    </div>
  </nav>
</header>

<main>
  <section class="hero-modern">
    <div class="hero-left">
      <h1>Welcome, <%= name %></h1>
      <p class="hero-subtitle">
        Browse events, join activities, and manage your bookings easily with EventPro.
      </p>
      <ul class="hero-points">
        <li>Explore available events from organizers</li>
        <li>Join events and book services easily</li>
        <li>Track your bookings and schedules</li>
        <li>Manage your profile and preferences</li>
      </ul>
      <div class="hero-buttons">
      <a href="/packages" class="hero-primary-btn">Explore Packages</a>
      <a href="/packages" class="hero-secondary-btn">Book Now</a>
      
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-mockup">
        <div class="mockup-header">
          <span></span><span></span><span></span>
        </div>
        <div class="mockup-body">
          <div class="mockup-sidebar">
            <div class="mockup-line short"></div>
            <div class="mockup-line"></div>
            <div class="mockup-line"></div>
          </div>
          <div class="mockup-content">
            <div class="mockup-card large"></div>
            <div class="mockup-card-row">
              <div class="mockup-card small"></div>
              <div class="mockup-card small"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="floating-tag top-tag">My Bookings</div>
      <div class="floating-badge">✓</div>
    </div>
    <div class="hero-curve"></div>
  </section>

  <div class="search-filter-container container">
      <input type="text" id="eventSearch" placeholder="Search events by name... 🔍">
      <select id="typeFilter">
          <option value="all">All Types</option>
          <option value="corporate">Corporate</option>
          <option value="party">Parties</option>
      </select>
  </div>
  <section class="events-section">
    <h2>Explore Events</h2>

    <div class="events-grid">
      <div class="event-card" data-category="corporate">
        <img src="/assets/images/event1.jpg" alt="Event">
        <h3>Founders Live Cairo</h3>
        <p>Sat, Apr 25 • 10:00 AM</p>
        <p>Startup Haus Cairo</p>
        <a href="/book-event?source=event&event=Founders%20Live%20Cairo&price=150"><button>Join Event</button></a>
      </div>

      <div class="event-card" data-category="corporate">
        <img src="/assets/images/event2.jpg" alt="Event">
        <h3>Investors Founders Meetup</h3>
        <p>Thu • 1:00 PM</p>
        <p>Cairo</p>
        <a href="/book-event?source=event&event=Investors%20Founders%20Meetup&price=250"><button>Join Event</button></a>
      </div>

      <div class="event-card" data-category="party">
        <img src="/assets/images/event3.jpg" alt="Event">
        <h3>Women Party 2026</h3>
        <p>Wed • 9:00 AM</p>
        <p>Ramses Hilton</p>
        <a href="/book-event?source=event&event=Women%20Party%202026&price=200"><button>Join Event</button></a>
      </div>

      <div class="event-card" data-category="party">
        <img src="/public/images/event4.jpg" alt="Event">
        <h3>AI Party Egypt</h3>
        <p>Sun • 8:30 AM</p>
        <p>Future University</p>
        <a href="/book-event?source=event&event=AI%20Party%20Egypt&price=300"><button>Join Event</button></a>
      </div>
    </div>
  </section>
</main>

<script src="/js/darkmode.js"></script>
<script src="/js/client&homepages&footer.js"></script>
</body>
</html>

