<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Booking Requests</title>

  <link rel="stylesheet" href="/css/organizer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="organizer-page">

   <div class="dashboard-container">
    <%- include('partials/sidebar', { role: 'organizer', active: 'booking-requests' }) %>

    <div class="dashboard-content">
      <h1>Booking Requests</h1>
      <p class="dashboard-subtitle">
        Custom event requests from clients. Reply with your price — the client
        picks the offer they like best.
      </p>

      <h2>Open Requests</h2>

      <% if (!requests || requests.length === 0) { %>
        <div class="empty-state">
          <p>No open booking requests right now.</p>
        </div>
      <% } else { %>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Request ID</th>
              <th>Client</th>
              <th>Event Type</th>
              <th>Guests</th>
              <th>Preferred Date</th>
              <th>Details</th>
              <th>Your Offer</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(r => {
                 const mine = (r.offers || []).find(o => o.organizerEmail === organizerEmail);
            %>
              <tr>
                <td><%= r._id.toString().slice(-6).toUpperCase() %></td>
                <td>
                  <%= r.clientName %><br>
                  <small><%= r.clientEmail %></small><br>
                  <small><%= r.phone %></small>
                </td>
                <td><%= r.eventType %></td>
                <td><%= r.guests %></td>
                <td><%= r.eventDate ? r.eventDate.toISOString().slice(0, 10) : 'Flexible' %></td>
                <td><%= r.notes || '—' %></td>
                <td>
                  <% if (mine) { %>
                    <span class="confirmed-price-value">You offered $<%= mine.price %></span>
                    <div><small>Update:</small></div>
                  <% } %>
                  <form action="/booking-requests/offer" method="POST" style="display:flex; gap:6px; align-items:center;">
                    <input type="hidden" name="requestId" value="<%= r._id %>">
                    <input type="number" name="price" min="1" placeholder="Price $" class="request-price-input" required>
                    <button type="submit" class="request-action-btn accept-btn"><%= mine ? 'Update' : 'Send Offer' %></button>
                  </form>
                  <small><%= (r.offers || []).length %> offer(s) so far</small>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>
