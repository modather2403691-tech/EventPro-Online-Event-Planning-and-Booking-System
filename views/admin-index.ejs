<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Home</title>

<link rel="stylesheet" href="/css/client&homepages&footer.css">
<link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/css/darkmode.css">
</head>
<body>

<!-- NAVBAR -->
<header>
  <nav class="home-navbar">
    <div class="home-logo">EventPro</div>

    <ul class="home-nav-links">
      <li><a href="/admin-index">Home</a></li>
      <li><a href="/manage-users">Users</a></li>
      <li><a href="/client-reservation">Client Reservation</a></li>
      <li><a href="/organizer-event">Organizer Event</a></li>
      <li><a href="/reports">Reports</a></li>
      <li><a href="/admin-dashboard">Dashboard</a></li>
    </ul>

    <div class="home-nav-actions">
      <a href="/logout" class="home-outline-btn">Logout</a>
    </div>
  </nav>
</header>

<!-- HERO -->
<section class="hero-modern">

  <div class="hero-left">
    <h1>Welcome, <%= name %></h1>

    <p class="hero-subtitle">
      Manage users, monitor bookings, and control the entire system.
    </p>

    <ul class="hero-points">
      <li>Manage all users (clients & organizers)</li>
      <li>Monitor bookings and system activity</li>
      <li>Generate reports and analytics</li>
      <li>Control platform operations</li>
    </ul>

    <div class="hero-buttons">
      <a href="/admin-dashboard" class="hero-primary-btn">Open Dashboard</a>
      <a href="/reports" class="hero-secondary-btn">View Reports</a>
      <a href="/login?email=modather%40gmail.com" class="hero-secondary-btn">Admin Login</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-mockup">
      <div class="mockup-header">
        <span></span><span></span><span></span>
      </div>

      <div class="mockup-body">
        <div class="mockup-sidebar">
          <div class="mockup-line short"></div>
          <div class="mockup-line"></div>
          <div class="mockup-line"></div>
        </div>

        <div class="mockup-content">
          <div class="mockup-card large"></div>
          <div class="mockup-card-row">
            <div class="mockup-card small"></div>
            <div class="mockup-card small"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="floating-tag top-tag">Admin Panel</div>
    <div class="floating-badge">✓</div>
  </div>

  <div class="hero-curve"></div>
</section>

<!-- SYSTEM OVERVIEW -->
<section class="events-section">
  <h2>System Overview</h2>

  <div class="events-grid">
    <div class="event-card">
      <img src="/assets/images/event1.jpg">
      <h3>Total Users</h3>
      <p>Manage all users</p>
      <button>View</button>
    </div>

    <div class="event-card">
      <img src="/assets/images/event2.jpg">
      <h3>Total Bookings</h3>
      <p>Monitor bookings</p>
      <button>View</button>
    </div>
  </div>
</section>
<script src="/js/client&homepages&footer.js"></script>
<script src="/js/admin.js"></script>
<script src="/js/darkmode.js"></script>

</body>
</html>

