<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Request Custom Event</title>
  <link rel="stylesheet" href="/css/packages.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="modern-bg modern-font">

  <header>
    <nav class="navbar">
      <div class="logo">EventPro</div>
      <ul class="nav-links">
        <li><a href="/client-index">Home</a></li>
        <li><a href="/my-requests">My Requests</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Request a Custom Event</h1>
    <p style="text-align:center; max-width:640px; margin:0 auto 20px;">
      Tell us about the party or event you want. Your request is sent to all
      organizers — they reply with a price, and you choose the best offer.
    </p>

    <div class="form-container modern-card">
      <form id="requestForm" method="POST" action="/booking-requests/create">

        <div>
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" class="modern-input" value="<%= name %>" required>
        </div>

        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="modern-input" value="<%= email %>" readonly required>
        </div>

        <div>
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" class="modern-input" placeholder="01xxxxxxxxx" value="<%= phone %>" required>
        </div>

        <div>
          <label for="eventType">Event Type</label>
          <select id="eventType" name="eventType" class="modern-input" required>
            <option value="Party">Party</option>
            <option value="Wedding">Wedding</option>
            <option value="Birthday">Birthday</option>
            <option value="Corporate">Corporate</option>
            <option value="Engagement">Engagement</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div>
          <label for="eventDate">Preferred Date</label>
          <input type="date" id="eventDate" name="eventDate" class="modern-input">
        </div>

        <div>
          <label for="guests">Number of Guests</label>
          <input type="number" id="guests" name="guests" class="modern-input" min="1" placeholder="e.g. 100">
        </div>

        <div>
          <label for="notes">Details / Notes</label>
          <textarea id="notes" name="notes" class="modern-input" placeholder="Describe your event, theme, budget, services you need..."></textarea>
        </div>

        <button type="submit" class="modern-button">Send Request to Organizers</button>
      </form>
    </div>
  </main>

  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>
