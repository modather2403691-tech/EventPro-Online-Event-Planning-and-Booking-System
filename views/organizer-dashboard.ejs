<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Organizer Dashboard</title>

  <link rel="stylesheet" href="/css/organizer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="organizer-page">

  <div class="dashboard-container">
    <%- include('partials/sidebar', { role: 'organizer', active: 'dashboard' }) %>

    <div class="dashboard-content">
      <h1>Organizer Dashboard</h1>

      <div class="cards">
        <div class="card">
          <h3>Total Packages</h3>
          <p>6</p>
        </div>

        <div class="card">
          <h3>Pending Requests</h3>
          <p>4</p>
        </div>

        <div class="card">
          <h3>Upcoming Events</h3>
          <p>5</p>
        </div>
      </div>

      <section class="dashboard-section">
        <h2>Recent Booking Requests</h2>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Request ID</th>
              <th>Client Name</th>
              <th>Event Type</th>
              <th>Date</th>
          
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>R001</td>
              <td>Sarah Ahmed</td>
              <td>Wedding</td>
              <td>2025-05-18</td>
              
            </tr>
            <tr>
              <td>R002</td>
              <td>Ali Hassan</td>
              <td>Party</td>
              <td>2025-06-02</td>
              
            </tr>
            <tr>
              <td>R003</td>
              <td>Mona Khaled</td>
              <td>Birthday</td>
              <td>2025-06-15</td>
          
            </tr>
          </tbody>
        </table>
      </section>
    </div>
  </div>

  <script src="/js/organizer.js"></script>
  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

