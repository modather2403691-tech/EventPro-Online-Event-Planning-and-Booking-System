<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Organizer Dashboard</title>

  <link rel="stylesheet" href="/css/organizer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="organizer-page">

  <div class="dashboard-container">
    <%- include('partials/sidebar', { role: 'organizer', active: 'dashboard', name: name, photo: photo }) %>

    <div class="dashboard-content">
      <h1>Organizer Dashboard</h1>

      <div class="cards">
        <div class="card">
          <h3>Total Events</h3>
          <p><%= totalEvents %></p>
        </div>

        <div class="card">
          <h3>Total Accepted Requests</h3>
          <p><%= totalRequested %></p>
        </div>
      </div>

      <section class="dashboard-section">
        <h2>Recent Client Activity</h2>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Client Name</th>
              <th>Source</th>
              <th>Event Type</th>
              <th>Date</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentBookings && recentBookings.length > 0) { %>
              <% recentBookings.forEach((booking, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= booking.userName || booking.userEmail %></td>
                  <td><%= booking.source === 'request' ? 'Accepted Request' : 'Event Booking' %></td>
                  <td><%= booking.eventType || 'Event' %></td>
                  <td><%= booking.eventDate ? booking.eventDate.toISOString().slice(0, 10) : 'TBD' %></td>
                  <td><%= booking.status || 'Pending' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; color:#666; padding:24px 0;">No client activity yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </section>
    </div>
  </div>

  <script src="/js/organizer.js"></script>
  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

