<body class="about-page">

  <header>
  <nav class="inner-navbar">
    <a href="/index" class="brand">EventPro</a>

    <button class="nav-toggle" aria-label="Open menu">☰</button>

    <ul class="nav-links">
      <li><a href="/">Home</a></li>
     
      <li><a href="/about" class="active">About</a></li>
      <li><a href="/resources">Resources</a></li>
      <li><a href="/security">Security</a></li>
      <li><a href="/contact" class="nav-btn">Contact</a></li>
    </ul>
  </nav>
</header>

  <main class="page-main">

    <section class="hero-modern about-hero">
      <div class="hero-left">
        <span class="section-badge">About Us</span>
        <h1>About EventPro</h1>
        <p class="hero-subtitle">
          Meet the team, explore our careers, and discover how our partners help us create unforgettable event experiences.
        </p>
      </div>
    </section>

    <section id="team" class="content-section">
      <div class="section-header">
        <h2>Our Team</h2>
        <p>
          EventPro is built by designers, planners, and technology specialists who make event management intuitive, creative, and reliable.
        </p>
      </div>

      <div class="about-grid">
        <div class="about-card">
          <h3>Event Strategists</h3>
          <p>Our planners create smooth and memorable event journeys for every client.</p>
        </div>

        <div class="about-card">
          <h3>Client Support</h3>
          <p>Our support team ensures quick responses and helpful guidance at every step.</p>
        </div>

        <div class="about-card">
          <h3>Product Team</h3>
          <p>We continuously improve the platform to make planning and booking easier.</p>
        </div>
      </div>
    </section>

    <section id="careers" class="content-section">
      <div class="section-header">
        <h2>Careers</h2>
        <p>
          Join a growing team that delivers seamless event experiences, smarter workflows, and unforgettable celebrations.
        </p>
      </div>

      <div class="about-highlight-box">
        <p>We are hiring for roles in operations, creative services, customer success, and platform development.</p>
        <a href="/contact" class="about-btn">Get in Touch</a>
      </div>
    </section>

    <section id="partners" class="content-section">
      <div class="section-header">
        <h2>Partners</h2>
        <p>
          Our partners include venues, caterers, decorators, and technology providers who help bring every event vision to life.
        </p>
      </div>

      <div class="partner-list">
        <div class="partner-item">Venues & Spaces</div>
        <div class="partner-item">Catering Services</div>
        <div class="partner-item">Decor & Styling</div>
        <div class="partner-item">Photography & Media</div>
        <div class="partner-item">Technology Providers</div>
        <div class="partner-item">Logistics Support</div>
      </div>
    </section>

  </main>

  <footer class="main-footer">
    <div class="footer-top">
      <h2 class="footer-logo">EventPro</h2>
      <p class="footer-tagline">
        Design unforgettable celebrations with smart planning, expert support, and creative packages tailored for every moment.
      </p>
    </div>

    <div class="footer-links">
      <div>
        <h4>About</h4>
        <ul>
          <li><a href="/about#team">Our Team</a></li>
          <li><a href="/about#careers">Careers</a></li>
          <li><a href="/about#partners">Partners</a></li>
        </ul>
      </div>

      

      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href="/resources#blog">Blog</a></li>
          <li><a href="/resources#case-studies">Case Studies</a></li>
          <li><a href="/resources#guides">Guides</a></li>
        </ul>
      </div>

      <div>
        <h4>Support</h4>
        <ul>
          <li><a href="/help-center">Help Center</a></li>
          <li><a href="/security">Security</a></li>
          <li><a href="/contact">Contact Support</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2026 EventPro. All rights reserved.</p>
    </div>

    <div class="footer-social">
      <span>🌐</span>
      <span>📘</span>
      <span>🐦</span>
      <span>▶️</span>
    </div>
  </footer>
  <script src="/js/client&homepages&footer.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
