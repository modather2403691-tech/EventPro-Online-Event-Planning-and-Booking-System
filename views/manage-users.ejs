<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Manage Users</title>

  <link rel="stylesheet" href="/css/Admin.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="admin-page" id="manageUsersPage">

  <% var users = typeof users !== 'undefined' ? users : []; %>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="brand-wrapper" id="brandLogo">
        <div class="brand-mark">I</div>
        <div class="brand-text">
          <span class="brand-name">Ismail</span>
          <span class="brand-subtitle">Admin</span>
        </div>
      </div>
      <nav aria-label="Admin navigation" id="adminNav">
        <h2 id="sidebarTitle">Admin Panel</h2>
        <ul id="sidebarMenu">
          <li id="sidebarItemDashboard"><a id="navDashboard" href="/admin-dashboard">Dashboard</a></li>
          <li id="sidebarItemUsers"><a id="navUsers" href="/admin/users">Manage Users</a></li>
          <li id="sidebarItemClientReservations"><a id="navClientReservations" href="/client-reservation">Client Reservation</a></li>
          <li id="sidebarItemOrganizerEvents"><a id="navOrganizerEvents" href="/organizer-event">Organizer Event</a></li>
          <li id="sidebarItemMessages"><a id="navMessages" href="/admin/messages">Messages</a></li>
          <li id="sidebarItemReports"><a id="navReports" href="/reports">Reports</a></li>
          <li id="sidebarItemHome"><a id="navHome" href="/admin-index">Back to Home</a></li>
        </ul>
      </nav>
    </aside>

    <div class="dashboard-content">
      <h1>Manage Users</h1>
      <div class="page-meta" id="pageMeta"></div>

      <section class="manage-users-form-wrap" aria-label="Add a new user">
        <h2>Add New User</h2>
        <form action="/admin/users" method="POST" id="addUserForm" class="manage-users-form" novalidate>
          <div class="manage-users-form-grid">
            <label>
              User ID
              <input type="text" name="userId" id="newUserId" placeholder="U004" required>
              <span class="error" id="newUserIdError"></span>
            </label>
            <label>
              Name
              <input type="text" name="name" id="newUserName" placeholder="Full name" required>
              <span class="error" id="newUserNameError"></span>
            </label>
            <label>
              Email
              <input type="email" name="email" id="newUserEmail" placeholder="user@example.com" required>
              <span class="error" id="newUserEmailError"></span>
            </label>
            <label>
              Password
              <input type="password" name="password" id="newUserPassword" placeholder="Password" required>
              <span class="error" id="newUserPasswordError"></span>
            </label>
            <label>
              Phone
              <input type="tel" name="phone" id="newUserPhone" placeholder="01xxxxxxxxx" required>
              <span class="error" id="newUserPhoneError"></span>
            </label>
            <label>
              Date of Birth
              <input type="date" name="dob" id="newUserDob" required>
              <span class="error" id="newUserDobError"></span>
            </label>
            <label>
              Role
              <select name="role" id="newUserRole" required>
                <option value="Client">Client</option>
                <option value="Organizer">Organizer</option>
                <option value="Admin">Admin</option>
              </select>
            </label>
            <label>
              Status
              <select name="status" id="newUserStatus" required>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
              </select>
            </label>
          </div>
          <button type="submit" class="manage-users-add-btn">Add User</button>
        </form>
      </section>

      <div class="manage-users-table-wrap">
        <table class="dashboard-table" id="manageUsersTable" aria-label="Manage users table with editable rows">
          <thead>
            <tr>
              <th>User ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>DOB</th>
              <th>Role</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="manageUsersTableBody">
            <% if (users && users.length > 0) { %>
                <% users.forEach(user => { %>
                    <tr data-user-id="<%= user._id %>">
                      <td data-field="userId"><%= user.userId || user._id.toString().substring(0, 6) %></td>
                      <td data-field="name"><%= user.name %></td>
                      <td data-field="email"><%= user.email %></td>
                      <td data-field="phone"><%= user.phone || 'N/A' %></td>
                      <td data-field="dob"><%= user.dob ? new Date(user.dob).toLocaleDateString() : 'N/A' %></td>
                      <td data-field="role"><%= user.role %></td>
                      <td data-field="status"><%= user.status || 'Active' %></td>
                      <td class="user-actions-cell">
                        <button type="button" class="user-action-btn user-edit-btn">Edit</button>
                        <button type="button" class="user-action-btn user-save-btn is-hidden">Save</button>
                        <button type="button" class="user-action-btn user-cancel-btn is-hidden">Cancel</button>
                        <button type="button" class="user-action-btn user-delete-btn">Delete</button>
                      </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                <td colspan="8" style="text-align: center; padding: 20px;">No users found in the database.</td>
                </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="/js/admin.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>