<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventPro - Login</title>
 <link rel="stylesheet" href="/css/login&regester&contact.css">
   <link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/css/darkmode.css">
</head>
<body class="login-page">
    <div class="container">
        <div class="animation-side">
            <div class="character-container">
                <div class="char purple-rect" id="char1">
                    <div class="eye"><div class="pupil"></div></div>
                </div>
                <div class="char black-rect" id="char2">
                    <div class="eye"><div class="pupil"></div></div>
                    <div class="eye"><div class="pupil"></div></div>
                </div>
                <div class="char orange-semi" id="char3">
                    <div class="eye"><div class="pupil"></div></div>
                </div>
                <div class="char yellow-pill" id="char4">
                    <div class="eye"><div class="pupil"></div></div>
                    <div class="eye"><div class="pupil"></div></div>
                    <div class="mouth"></div>
                </div>
            </div>
        </div>

        <div class="form-side">
            <div class="login-box">
                <header>
                    <div class="logo-icon">✦</div>
                    <h1>Welcome back!</h1>
                    <p>Please enter your details</p>
                    <% if (typeof error !== 'undefined' && error) { %>
    <div style="color: red; text-align: center; font-weight: bold; margin-bottom: 15px;">
        <%= error %>
    </div>
<% } %>
                </header>
                <form id="loginForm" action="/login" method="POST">
                    <div class="input-group">
                        <label>Email</label>
                        <input type="email" id="loginEmail" name="email" placeholder="Enter your email" autocomplete="email" required>
                        <span class="error-msg">Please enter a valid email</span>
                    </div>
                    <div class="input-group">
                        <label>Password</label>
                        <div class="pass-wrapper">
                            <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
                            <span class="toggle-pass" id="toggleEye">👁</span>
                        </div>
                        <span class="error-msg">Password is required</span>
                    </div>
                    <div class="form-options">
                        <div class="remember">
                            <input type="checkbox" id="rem">
                            <label for="rem">Remember for 30 days</label>
                        </div>
                        <a href="#">Forgot password?</a>
                    </div>
                    <button type="submit" class="btn-login">Log in</button>
                    <button type="button" class="btn-google">
                        <img src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png" width="18" alt="">
                        Log in with Google
                    </button>
                </form>
                <p class="footer-text">Don't have an account? <a href="register.html">Sign Up</a></p>
            </div>
        </div>
    </div>
 
  <script src="/js/login&regester&contact.js"></script>
<script src="/js/darkmode.js"></script>
 
</body>
</html>