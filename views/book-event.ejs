<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Book Event</title>
  <link rel="stylesheet" href="/css/packages.css">
  <link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="modern-bg modern-font">

  <header>
    <nav class="navbar">
      <div class="logo">EventPro</div>
      <ul class="nav-links">
        <li><a href="/client-index">Home</a></li>
        <li><a href="/packages">Packages</a></li>
        
      
      </ul>
    </nav>
  </header>

  <main>
    <h1>Book Your Event</h1>

    <% if (event) { %>
      <div class="event-summary modern-card" style="margin-bottom:16px;padding:12px;">
        <h2 style="margin-top:0; color: white;"><%= event.title %></h2>
        <% if (event.location) { %>
          <p><strong>Location:</strong> <%= event.location %></p>
        <% } %>
        <% if (event.date) { %>
          <p><strong>Date:</strong> <%= event.date.toISOString().slice(0,10) %></p>
        <% } %>
        <% if (event.rules) { %>
          <p style="margin-top:8px;"><strong>Event Rules:</strong><br><%= event.rules %></p>
        <% } %>
      </div>
    <% } %>

    <div class="form-container modern-card" >
      <form id="bookingForm" method="POST" action="/book-event">
        <input type="hidden" id="source" name="source" value="<%= source || '' %>">
        <input type="hidden" id="price" name="price" value="<%= price || 0 %>">
        <input type="hidden" id="eventId" name="eventId" value="<%= event && event._id ? event._id : '' %>">

        <div>
  <label for="name">Full Name</label>
  <input type="text" id="name" name="name" class="modern-input" value="<%= name %>">
  <span id="nameError" class="error"></span>
</div>

<div>
  <label for="email">Email</label>
  <input type="email" id="email" name="email" class="modern-input" value="<%= email %>" readonly>
  <span id="emailError" class="error"></span>
</div>

<div>
  <label for="phone">Phone Number</label>
 <input type="tel" id="phone" name="phone" class="modern-input" placeholder="01xxxxxxxxx" value="<%= phone %>">
  <span id="phoneError" class="error"></span>
</div>

<div>
  <label for="eventType">Event Type</label>
  <input type="text" id="eventType" name="eventType" class="modern-input" readonly value="<%= event ? (event.category || event.title) : '' %>">
  <span id="eventTypeError" class="error"></span>
</div>

<div id="eventDateSection">
  <label for="eventDate">Event Date</label>
  <input type="date" id="eventDate" name="eventDate" class="modern-input" value="<%= event && event.date ? event.date.toISOString().slice(0,10) : '' %>">
  <span id="dateError" class="error"></span>
</div>

<div id="guestsSection">
  <label for="guests">Number of Guests</label>
  <input type="number" id="guests" name="guests" class="modern-input">
  <span id="guestsError" class="error"></span>
</div>
<div id="priceDisplaySection" style="display: none; margin: 15px 0; font-weight: bold; font-size: 1.2rem; color: #2ecc71;">
  Total Price: $<span id="eventDisplayPrice">0</span>
</div>

<button type="submit" class="modern-button">Submit Booking</button>
      </form>
    </div>
  </main>

 
  <script src="/js/login&regester&contact.js"></script>
  <script src="/js/packages.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

