<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Reports</title>

  <!-- CSS -->
 <link rel="stylesheet" href="/css/Admin.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="admin-page" id="reportsPage">
  <% const reportMetrics = typeof metrics !== 'undefined' ? metrics : { monthlyBookings: 0, completedEvents: 0, totalRevenue: 0, totalBookings: 0 }; %>
  <% const rows = typeof reportRows !== 'undefined' && Array.isArray(reportRows) ? reportRows : []; %>

  <div class="dashboard-container">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="brand-wrapper" id="brandLogo">
        <div class="brand-mark">I</div>
        <div class="brand-text">
          <span class="brand-name">Ismail</span>
          <span class="brand-subtitle">Admin</span>
        </div>
      </div>
      <nav aria-label="Admin navigation" id="adminNav">
        <h2 id="sidebarTitle">Admin Panel</h2>
        <ul id="sidebarMenu">
          <li id="sidebarItemDashboard"><a id="navDashboard" href="/admin-dashboard">Dashboard</a></li>
          <li id="sidebarItemUsers"><a id="navUsers" href="/manage-users">Manage Users</a></li>
          <li id="sidebarItemClientReservations"><a id="navClientReservations" href="/client-reservation">Client Reservation</a></li>
          <li id="sidebarItemOrganizerEvents"><a id="navOrganizerEvents" href="/organizer-event">Organizer Event</a></li>
          <li id="sidebarItemReports"><a id="navReports" href="/reports">Reports</a></li>
          <li id="sidebarItemHome"><a id="navHome" href="/admin-index">Back to Home</a></li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="dashboard-content">
      <h1>Reports</h1>
      <div class="page-meta" id="pageMeta">
        <span>Live report summary</span>
      </div>

      <!-- Cards -->
      <div class="cards">
        <div class="card">
          <h3>Monthly Bookings</h3>
          <p><%= reportMetrics.monthlyBookings %></p>
        </div>

        <div class="card">
          <h3>Completed Events</h3>
          <p><%= reportMetrics.completedEvents %></p>
        </div>

        <div class="card">
          <h3>Estimated Revenue</h3>
          <p>$<%= Number(reportMetrics.totalRevenue || 0).toLocaleString('en-US') %></p>
        </div>
      </div>

      <!-- Report Table -->
      <section class="dashboard-section">
        <h2>Report Summary</h2>

        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Month</th>
              <th>Total Bookings</th>
              <th>Completed</th>
              <th>Pending</th>
              <th>Revenue</th>
            </tr>
          </thead>

          <tbody>
            <% if (rows.length > 0) { %>
              <% rows.forEach(row => { %>
                <tr>
                  <td><%= row.month %></td>
                  <td><%= row.totalBookings %></td>
                  <td><%= row.completed %></td>
                  <td><%= row.pending %></td>
                  <td>$<%= Number(row.revenue || 0).toLocaleString('en-US') %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align:center; padding:20px;">No booking data available yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>

      </section>

    </div>
  </div>
  <script src="/js/admin.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

