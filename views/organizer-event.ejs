<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Organizer Event</title>

 <link rel="stylesheet" href="/css/Admin.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="admin-page" id="organizerEventPage">
  <% const eventsList = typeof events !== 'undefined' && Array.isArray(events) ? events : []; %>
  <% const acceptedList = typeof acceptedPackages !== 'undefined' && Array.isArray(acceptedPackages) ? acceptedPackages : []; %>
  <% const createdList = typeof createdEvents !== 'undefined' && Array.isArray(createdEvents) ? createdEvents : []; %>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="brand-wrapper" id="brandLogo">
        <div class="brand-mark">I</div>
        <div class="brand-text">
          <span class="brand-name">Ismail</span>
          <span class="brand-subtitle">Admin</span>
        </div>
      </div>
      <nav aria-label="Admin navigation" id="adminNav">
        <h2 id="sidebarTitle">Admin Panel</h2>
        <ul id="sidebarMenu">
          <li id="sidebarItemDashboard"><a id="navDashboard" href="/admin-dashboard">Dashboard</a></li>
          <li id="sidebarItemUsers"><a id="navUsers" href="/manage-users">Manage Users</a></li>
          <li id="sidebarItemClientReservations"><a id="navClientReservations" href="/client-reservation">Client Reservation</a></li>
          <li id="sidebarItemOrganizerEvents"><a id="navOrganizerEvents" href="/organizer-event">Organizer Event</a></li>
          <li id="sidebarItemMessages"><a id="navMessages" href="/admin/messages">Messages</a></li>
          <li id="sidebarItemReports"><a id="navReports" href="/reports">Reports</a></li>
          <li id="sidebarItemHome"><a id="navHome" href="/admin-index">Back to Home</a></li>
        </ul>
      </nav>
    </aside>

    <main class="dashboard-content">
      <h1>Organizer Event</h1>
      

      <div class="organizer-spotlights">
        <article class="organizer-spotlight-card">
          <h3>Top Package Acceptance</h3>
          <p class="spotlight-name"><%= acceptedList[0] ? acceptedList[0].organizer : 'No data yet' %></p>
          <span class="spotlight-meta"><%= acceptedList[0] ? acceptedList[0].acceptedPackages + ' accepted packages this quarter' : 'No bookings yet' %></span>
        </article>

        <article class="organizer-spotlight-card">
          <h3>Top Event Creator</h3>
          <p class="spotlight-name"><%= createdList[0] ? createdList[0].organizer : 'No data yet' %></p>
          <span class="spotlight-meta"><%= createdList[0] ? createdList[0].eventsAdded + ' events created this quarter' : 'No events yet' %></span>
        </article>
      </div>

      <section class="dashboard-section">
        <h2 class="organizer-section-title">Available Events by Organizer</h2>
        <div class="organizer-table-wrap">
          <table class="dashboard-table" id="organizerEventsTable" aria-label="Available events and their organizers">
            <thead>
              <tr>
                <th>Event ID</th>
                <th>Event Title</th>
                <th>Organizer</th>
                <th>Event Date</th>
                <th>Number of Guests</th>

                <th>Availability</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="organizerEventsTableBody">
              <% if (eventsList.length > 0) { %>
                <% eventsList.forEach(event => { %>
                  <% const eventDate = event.date ? new Date(event.date).toLocaleDateString('en-CA') : 'N/A'; %>
                  <% const availability = event.capacity > 100 ? 'Available' : (event.capacity > 0 ? 'Limited' : 'Unavailable'); %>
                  <tr>
                    <td data-field="eventId">EVT-<%= String(event._id).slice(-6).toUpperCase() %></td>
                    <td data-field="eventTitle"><%= event.title %></td>
                    <td data-field="organizer"><%= event.organizerName %></td>
                    <td data-field="eventDate"><%= eventDate %></td>
                    <td data-field="guests"><%= event.capacity || 0 %></td>
                    <td data-field="availability"><%= availability %></td>
                    <td class="organizer-event-actions-cell">
                      <button type="button" class="event-action-btn event-edit-btn">Edit</button>
                      <button type="button" class="event-action-btn event-save-btn is-hidden">Save</button>
                      <button type="button" class="event-action-btn event-cancel-btn is-hidden">Cancel</button>
                      <button type="button" class="event-action-btn event-remove-btn">Remove</button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" style="text-align:center; padding:20px;">No events available yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="dashboard-section">
        <h2 class="organizer-section-title">Most Organizers Accepting Packages</h2>
        <div class="organizer-table-wrap">
          <table class="dashboard-table" aria-label="Top organizers by accepted packages">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Organizer</th>
                <th>Accepted Packages</th>
           
                <th>Acceptance Rate</th>
              </tr>
            </thead>
            <tbody>
              <% if (acceptedList.length > 0) { %>
                <% acceptedList.forEach(item => { %>
                  <tr>
                    <td><%= item.rank %></td>
                    <td><%= item.organizer %></td>
                    <td><%= item.acceptedPackages %></td>
                    <td><%= item.acceptanceRate %>%</td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" style="text-align:center; padding:20px;">No organizer acceptance data yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="dashboard-section">
        <h2 class="organizer-section-title">Most Organizers Adding Events</h2>
        <div class="organizer-table-wrap">
          <table class="dashboard-table" aria-label="Top organizers by added events">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Organizer</th>
                <th>Events Added</th>
                
                <th>Latest Added Event Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (createdList.length > 0) { %>
                <% createdList.forEach(item => { %>
                  <tr>
                    <td><%= item.rank %></td>
                    <td><%= item.organizer %></td>
                    <td><%= item.eventsAdded %></td>
                    <td><%= item.latestAddedEventDate %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" style="text-align:center; padding:20px;">No organizer event data yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/admin.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>


