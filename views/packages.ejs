<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Packages</title>

  <link rel="stylesheet" href="../public/css/packages.css">
  <link rel="stylesheet" href="../public/css/responsive.css">
    <link rel="stylesheet" href="../public/css/client&homepages&footer.css">
    <link rel="stylesheet" href="../public/css/responsive.css">
    <link rel="stylesheet" href="../public/css/darkmode.css">
</head>

<body class="packages-page">

 <header>
    <nav class="navbar">
      <div class="logo">EventPro</div>
      <ul class="nav-links">
        <li><a href="client-index.html">Home</a></li>
        
        
      
      </ul>
    </nav>
  </header>

  <!-- Hero -->
  <section class="packages-hero">
    <h1>Plan Your Perfect Event</h1>
    <p>Customize your perfect event with our best packages</p>
  </section>

  <div class="search-filter-container">
  <input type="text" id="packageSearch" placeholder="Search for packages (e.g. Wedding, Party)...">
  <select id="priceFilter">
    <option value="all">All Prices</option>
    <option value="cheap">Under $500</option>
    <option value="expensive">Above $500</option>
  </select>
</div>

  <!-- Packages -->
  <section class="packages-wrapper">

    <div class="package-card new" id="wedding">
      <h2>Wedding</h2>
      <p>Luxury wedding with full service & premium setup.</p>
      <ul>
        <li>Decoration</li>
        <li>Catering</li>
        <li>Photography</li>
      </ul>
      <a href="package-details.html?type=wedding" class="btn">Details</a>
      
    </div>

    <div class="package-card highlight" id="party">
      <div class="badge">Most Popular</div>
      <h2>Party Package</h2>
      <p>Enjoy a vibrant party setup with music, lighting, decoration, and catering for an unforgettable celebration.</p>
      <ul>
        <li>DJ & Music</li>
        <li>Lighting Effects</li>
        <li>Decoration</li>
        <li>Catering</li>
      </ul>
     <a href="package-details.html?type=party" class="btn">Details</a>
    </div>

    <div class="package-card new" id="birthday">
      <h2>Birthday</h2>
      <p>Fun party with music, cake & decorations.</p>
      <ul>
        <li>DJ & Music</li>
        <li>Cake</li>
        <li>Decor</li>
      </ul>
      <a href="package-details.html?type=birthday" class="btn">Details</a>
    </div>

  </section>
  <script src="../public/js/packages.js"></script>
  <script src="../public/js/darkmode.js"></script>
</body>
</html>