<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organizer Home</title>

  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">

</head>
<body>

<!-- NAVBAR -->
<header>
  <nav class="home-navbar">
    <div class="home-logo">EventPro</div>

    <ul class="home-nav-links">
      <li><a href="/organizer-index">Home</a></li>
      
      <li><a href="/booking-requests">Requests</a></li>
      <li><a href="/availability">Availability</a></li>
      <li><a href="/organizer-dashboard">Dashboard</a></li>
      <li><a href="/organizer-profile">Profile</a></li>
    </ul>

    <div class="home-nav-actions">
      <a href="/logout" class="home-outline-btn">Logout</a>
    </div>
  </nav>
</header>

<!-- HERO -->
<section class="hero-modern">

  <div class="hero-left">
    <h1>Welcome, <%= name %></h1>

    <p class="hero-subtitle">
      Create and manage events, handle booking requests, and control availability.
    </p>

    <ul class="hero-points">
      <li>Accept or reject booking requests</li>
      <li>Track upcoming events</li>
      <li>Manage availability calendar</li>
    </ul>

    <div class="hero-buttons">
      <a href="/booking-requests" class="hero-secondary-btn">View Requests</a>
      <a href="/login?email=organizer%40gmail.com" class="hero-primary-btn">Organizer Login</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-mockup">
      <div class="mockup-header">
        <span></span><span></span><span></span>
      </div>

      <div class="mockup-body">
        <div class="mockup-sidebar">
          <div class="mockup-line short"></div>
          <div class="mockup-line"></div>
          <div class="mockup-line"></div>
        </div>

        <div class="mockup-content">
          <div class="mockup-card large"></div>
          <div class="mockup-card-row">
            <div class="mockup-card small"></div>
            <div class="mockup-card small"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="floating-tag top-tag">Requests</div>
    <div class="floating-badge">✓</div>
  </div>

  <div class="hero-curve"></div>
</section>

<!-- EVENTS -->
<section class="events-section">
  <h2>Your Events</h2>

  <div class="events-grid">
    <div class="event-card">i
      <img src="/assets/images/event1.jpg">
      <h3>Wedding Event</h3>
      <p>Status: Active</p>
      <button>Manage</button>
    </div>

    <div class="event-card">
      <img src="/public/images/event2.jpg">
      <h3>Party</h3>
      <p>Status: Pending</p>
      <button>Manage</button>
    </div>
  </div>
</section>
<script src="/js/darkmode.js"></script>
<script src="/js/client&homepages&footer.js"></script>
</body>
</html>

