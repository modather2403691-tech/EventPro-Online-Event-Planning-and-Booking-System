<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organizer Home</title>

  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body>

<!-- NAVBAR -->
<header>
  <nav class="home-navbar">
    <div class="home-logo">EventPro</div>

    <ul class="home-nav-links">
      <li><a href="/organizer-index">Home</a></li>
      <li><a href="/addevent">Add Event</a></li>
      <li><a href="/manage-events">My Events</a></li>
      <li><a href="/booking-requests">Requests</a></li>
      <li><a href="/organizer-dashboard">Dashboard</a></li>
      <li><a href="/organizer-profile">Profile</a></li>
    </ul>

    <div class="home-nav-actions">
      <a href="/logout" class="home-outline-btn">Logout</a>
    </div>
  </nav>
</header>

<!-- HERO -->
<section class="hero-modern">

  <div class="hero-left">
    <h1>Welcome, <%= name %></h1>

    <p class="hero-subtitle">
      Create and manage events, handle booking requests, and grow your business.
    </p>

    <ul class="hero-points">
      <li>Accept or reject booking requests</li>
      <li>Track upcoming events</li>
      <li>Manage your events and bookings</li>
    </ul>

    <div class="hero-buttons">
      <a href="/addevent" class="hero-primary-btn">Create Event</a>
      <a href="/booking-requests" class="hero-secondary-btn">View Requests</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-mockup">
      <div class="mockup-header">
        <span></span><span></span><span></span>
      </div>

      <div class="mockup-body">
        <div class="mockup-sidebar">
          <div class="mockup-line short"></div>
          <div class="mockup-line"></div>
          <div class="mockup-line"></div>
        </div>

        <div class="mockup-content">
          <div class="mockup-card large"></div>
          <div class="mockup-card-row">
            <div class="mockup-card small"></div>
            <div class="mockup-card small"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="floating-tag top-tag">Requests</div>
    <div class="floating-badge">✓</div>
  </div>

  <div class="hero-curve"></div>
</section>

<!-- EVENTS -->
<section class="events-section">
  <h2>Your Events</h2>

  <div class="events-grid">
    <% if (typeof events !== 'undefined' && events && events.length) { %>
      <% events.forEach(event => { %>
        <div class="event-card">
          <img src="<%= event.image ? event.image : '/images/event1.jpg' %>" alt="Event">
          <h3><%= event.title %></h3>
          <p><%= event.date ? event.date.toISOString().slice(0, 10) : 'Date TBD' %></p>
          <p><%= event.location %> · $<%= event.price %></p>
          <a href="/manage-events"><button>Manage</button></a>
        </div>
      <% }) %>
    <% } else { %>
      <p class="muted">You haven't created any events yet. <a href="/addevent">Add one</a>.</p>
    <% } %>
  </div>
</section>
<script src="/js/darkmode.js"></script>
<script src="/js/client&homepages&footer.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

