<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Client Reservation</title>

 <link rel="stylesheet" href="/css/Admin.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="admin-page" id="clientReservationPage">
  <% const requestsList = typeof requests !== 'undefined' && Array.isArray(requests) ? requests : []; %>
  <% const joinedList = typeof joinedEvents !== 'undefined' && Array.isArray(joinedEvents) ? joinedEvents : []; %>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="brand-wrapper" id="brandLogo">
        <div class="brand-mark">I</div>
        <div class="brand-text">
          <span class="brand-name">Ismail</span>
          <span class="brand-subtitle">Admin</span>
        </div>
      </div>
      <nav aria-label="Admin navigation" id="adminNav">
        <h2 id="sidebarTitle">Admin Panel</h2>
        <ul id="sidebarMenu">
          <li id="sidebarItemDashboard"><a id="navDashboard" href="/admin-dashboard">Dashboard</a></li>
          <li id="sidebarItemUsers"><a id="navUsers" href="/manage-users">Manage Users</a></li>
          <li id="sidebarItemClientReservations"><a id="navClientReservations" href="/client-reservation">Client Reservation</a></li>
          <li id="sidebarItemOrganizerEvents"><a id="navOrganizerEvents" href="/organizer-event">Organizer Event</a></li>
          <li id="sidebarItemMessages"><a id="navMessages" href="/admin/messages">Messages</a></li>
          <li id="sidebarItemReports"><a id="navReports" href="/reports">Reports</a></li>
          <li id="sidebarItemHome"><a id="navHome" href="/admin-index">Back to Home</a></li>
        </ul>
      </nav>
    </aside>

    <main class="dashboard-content">
      <h1>Client Reservation</h1>
      
      <section class="dashboard-section">
        <h2>Package Requests</h2>
        <div class="reservation-table-wrap">
          <table class="dashboard-table" aria-label="Client package requests">
            <thead>
              <tr>
                <th>ID</th>
                <th>Client Name</th>
                <th>Requested Package</th>
                <th>Event Date</th>
                <th>Request Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (requestsList.length > 0) { %>
                <% requestsList.forEach(request => { %>
                  <tr>
                    <td>CR-<%= String(request._id).slice(-6).toUpperCase() %></td>
                    <td><%= request.clientName %></td>
                    <td><%= request.eventType %></td>
                    <td><%= request.eventDate ? new Date(request.eventDate).toLocaleDateString('en-CA') : 'N/A' %></td>
                    <td><span class="status-pill <%= request.status === 'Confirmed' ? 'status-approved' : request.status === 'Cancelled' ? 'status-declined' : 'status-pending' %>"><%= request.status %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align:center; padding:20px;">No client requests found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="dashboard-section">
        <h2>Joined Events</h2>
        <div class="reservation-table-wrap">
          <table class="dashboard-table" aria-label="Client joined events">
            <thead>
              <tr>
                <th>ID</th>
                <th>Client Name</th>
                <th>Event Title</th>
                <th>Event Date</th>
                <th>Joined Event</th>
              </tr>
            </thead>
            <tbody>
              <% if (joinedList.length > 0) { %>
                <% joinedList.forEach(booking => { %>
                  <tr>
                    <td>JE-<%= String(booking._id).slice(-6).toUpperCase() %></td>
                    <td><%= booking.userName %></td>
                    <td><%= booking.eventType %></td>
                    <td><%= booking.eventDate ? new Date(booking.eventDate).toLocaleDateString('en-CA') : 'N/A' %></td>
                    <td><span class="status-pill status-joined"><%= booking.status === 'Confirmed' ? 'Yes' : booking.status %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align:center; padding:20px;">No joined events found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>


