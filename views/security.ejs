<body class="security-page">
<header>
  <nav class="inner-navbar">
    <a href="/index" class="brand">EventPro</a>

    <button class="nav-toggle" aria-label="Open menu">☰</button>

    <ul class="nav-links">
      <li><a href="/index">Home</a></li>
     
      <li><a href="/about" class="active">About</a></li>
      <li><a href="/resources">Resources</a></li>
      <li><a href="/security">Security</a></li>
      <li><a href="/contact" class="nav-btn">Contact</a></li>
    </ul>
  </nav>
</header>

  <main class="page-main">

    <section class="hero-modern security-hero">
      <div class="hero-left">
        <span class="security-badge">Security & Trust</span>
        <h1>Security at EventPro</h1>
        <p class="hero-subtitle">
          Learn how we protect your event data, secure your bookings, and maintain a safe experience for every client and organizer.
        </p>
      </div>
    </section>

    <section class="content-section">
      <div class="section-header">
        <h2>Safety & Privacy</h2>
        <p>
          EventPro uses secure protocols, encrypted communication, and controlled access systems to help protect personal information and booking activity.
        </p>
      </div>

      <div class="security-grid">
        <div class="security-card">
          <h3>Secure Booking Flow</h3>
          <p>We design the booking experience to reduce risk and keep event requests protected.</p>
        </div>

        <div class="security-card">
          <h3>Encrypted Communication</h3>
          <p>Data shared between users and the platform is protected through modern communication safeguards.</p>
        </div>

        <div class="security-card">
          <h3>Privacy First</h3>
          <p>Your personal details are handled carefully with privacy-focused platform practices.</p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="section-header">
        <h2>How We Keep Event Data Safe</h2>
      </div>

      <ul class="security-list">
        <li>Secure booking and payment systems</li>
        <li>Privacy-first handling of personal data</li>
        <li>Trusted partner and platform safeguards</li>
        <li>Controlled admin and organizer access</li>
        <li>Ongoing monitoring for account and activity protection</li>
      </ul>
    </section>

    <section class="content-section">
      <div class="section-header">
        <h2>User Protection</h2>
        <p>
          We aim to provide a safe environment for clients, organizers, and administrators by improving access control, account protection, and secure workflows across the platform.
        </p>
      </div>

      <div class="security-highlight-box">
        <p>
          Have questions about account safety or privacy? Contact our support team for help and guidance.
        </p>
        <a href="/contact" class="security-btn">Contact Support</a>
      </div>
    </section>

  </main>

  <footer class="main-footer">
    <div class="footer-top">
      <h2 class="footer-logo">EventPro</h2>
      <p class="footer-tagline">
        Design unforgettable celebrations with smart planning, expert support, and creative packages tailored for every moment.
      </p>
    </div>

    <div class="footer-links">
      <div>
        <h4>About</h4>
        <ul>
          <li><a href="/about#team">Our Team</a></li>
          <li><a href="/about#careers">Careers</a></li>
          <li><a href="/about#partners">Partners</a></li>
        </ul>
      </div>

      

      <div>
