<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Package Details</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/packages.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="package-details-page">
  <header>
    <nav class="navbar">
      <div class="logo">EventPro</div>
      <ul class="nav-links">
        <li><a href="/client-index">Home</a></li>
        <li><a href="/packages">Packages</a></li>
        
      
      </ul>
    </nav>
  </header>

  <div class="video-background">
  <video autoplay muted loop playsinline id="bg-video">
    <source id="bg-video-source" src="" type="video/mp4">
    Your browser does not support the video tag.
  </video>
</div>


  
  <main>
    <div class="package-card" id="package-cards">

      <h1 id="package-title">Package Name</h1>
      <p id="package-desc">Package description will appear here.</p>

      <h3>Included Services:</h3>
      <ul id="package-services"></ul>

      <h3>Additional Services:</h3>
      <ul id="package-addons"></ul>

      <button id="book-btn">Book Event</button>

    </div>
  </main>
  <script src="/js/packages.js"></script>
  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

