<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Client Dashboard</title>
  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="client-dashboard-page">

  <div class="dashboard-container">
    <%- include('partials/sidebar', { role: 'client', active: 'dashboard', name: name, photo: photo }) %>

    <div class="dashboard-content">
      <h1>Client Dashboard</h1>
      <p class="dashboard-subtitle">
        Track your bookings, event progress, and activity overview in one place.
      </p>

      <div class="client-dashboard-grid">
        <div class="client-main-panel">

          <!-- Pending bookings -->
          <div class="client-status-block teal">
            <div class="status-label-box">
              <h3>Awaiting Confirmation</h3>
              <% if (pending && pending.length > 0) { %>
                <% pending.slice(0, 3).forEach(b => { %><p><%= b.eventType %></p><% }) %>
              <% } else { %>
                <p style="color:#aaa;">No pending bookings</p>
              <% } %>
            </div>

            <div class="status-table-box">
              <div class="status-table-header">
                <span>Event</span>
                <span>Status</span>
                <span>Price</span>
                <span>Date</span>
              </div>

              <% if (pending && pending.length > 0) { %>
                <% pending.slice(0, 4).forEach(b => { %>
                <div class="status-row">
                  <span><%= b.eventType %></span>
                  <span><div class="progress-bar"><div class="fill teal-fill w40"></div></div></span>
                  <span>$<%= b.price || 0 %></span>
                  <span><%= b.eventDate ? new Date(b.eventDate).toLocaleDateString('en-US', {month:'short', day:'numeric'}) : 'TBD' %></span>
                </div>
                <% }) %>
              <% } else { %>
                <div class="status-row"><span colspan="4" style="color:#aaa;">No pending bookings</span></div>
              <% } %>
            </div>
          </div>

          <!-- Confirmed bookings -->
          <div class="client-status-block gold">
            <div class="status-label-box">
              <h3>Confirmed Bookings</h3>
              <% if (confirmed && confirmed.length > 0) { %>
                <% confirmed.slice(0, 3).forEach(b => { %><p><%= b.eventType %></p><% }) %>
              <% } else { %>
                <p style="color:#aaa;">No confirmed bookings yet</p>
              <% } %>
            </div>

            <div class="status-table-box">
              <div class="status-table-header">
                <span>Event</span>
                <span>Status</span>
                <span>Price</span>
                <span>Date</span>
              </div>

              <% if (confirmed && confirmed.length > 0) { %>
                <% confirmed.slice(0, 4).forEach(b => { %>
                <div class="status-row">
                  <span><%= b.eventType %></span>
                  <span><div class="progress-bar"><div class="fill gold-fill w100"></div></div></span>
                  <span>$<%= b.price || 0 %></span>
                  <span><%= b.eventDate ? new Date(b.eventDate).toLocaleDateString('en-US', {month:'short', day:'numeric'}) : 'TBD' %></span>
                </div>
                <% }) %>
              <% } else { %>
                <div class="status-row"><span style="color:#aaa;">No confirmed bookings</span></div>
              <% } %>
            </div>
          </div>

          <!-- Empty state -->
          <% if ((!bookings || bookings.length === 0)) { %>
          <div class="client-status-block peach" style="text-align:center; padding:30px;">
            <h3>No bookings yet</h3>
            <p style="margin:10px 0 18px; color:#888;">Start by exploring our packages or joining an event.</p>
            <a href="/packages" style="background:linear-gradient(90deg,#ff9a3c,#ff4fa0);color:#fff;padding:10px 24px;border-radius:999px;font-weight:700;text-decoration:none;">Browse Packages</a>
          </div>
          <% } %>

        </div>

        <!-- Analytics panel -->
        <div class="client-analytics-panel">
          <h2>Analytics</h2>

          <div class="analytics-cards">
            <div class="analytics-card">
              <span>Total Bookings</span>
              <strong><%= stats.total %></strong>
            </div>
            <div class="analytics-card">
              <span>Upcoming</span>
              <strong><%= stats.upcoming %></strong>
            </div>
            <div class="analytics-card">
              <span>Confirmed</span>
              <strong><%= stats.completed %></strong>
            </div>
            <div class="analytics-card">
              <span>Pending</span>
              <strong><%= stats.pending %></strong>
            </div>
          </div>

          <div class="analytics-donut-box">
            <h3>Booking Completion Rate</h3>
            <div class="fake-donut">
              <span><%= stats.completionRate %>%</span>
            </div>
          </div>

          <div class="analytics-chart-box">
            <h3>Total Bookings</h3>
            <div class="chart-number"><%= stats.total %></div>
            <p>Total bookings placed on your account</p>
            <div class="fake-bars">
              <% for(let i = 0; i < 8; i++) { %>
                <span style="height:<%= Math.max(10, Math.round(Math.random() * 60 + 20)) %>px"></span>
              <% } %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>
