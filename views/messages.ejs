<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventPro - Messages</title>

    <link rel="stylesheet" href="/css/organizer.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/darkmode.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="organizer-page">

    <div class="dashboard-container">
        <%- include('partials/sidebar', { role: 'admin', active: 'messages', name: name }) %>

        <div class="dashboard-content">
            <h1>Contact Messages</h1>
            <p class="dashboard-subtitle">Messages sent via the Contact form — you can review and remove items.</p>

            <% if (!messages || messages.length === 0) { %>
                <div class="empty-state">
                    <p>No messages yet.</p>
                </div>
            <% } else { %>
                <% messages.forEach(msg => { %>
                    <section class="request-details-panel" style="margin-bottom:18px;">
                        <div class="profile-box-header" style="margin-bottom:14px;">
                            <h3 style="margin:0;"><%= msg.name %></h3>
                            <form method="POST" action="/admin/messages/delete" onsubmit="return confirm('Delete this message?');">
                                <input type="hidden" name="messageId" value="<%= msg._id %>" />
                                <button type="submit" class="btn-danger">Delete</button>
                            </form>
                        </div>

                        <div class="request-details-grid">
                            <p><span>Email</span><strong class="detail-value email-value"><%= msg.email %></strong></p>
                            <p><span>Received</span><strong class="detail-value"><%= new Date(msg.createdAt).toLocaleString() %></strong></p>
                            <p class="detail-email"><span>Message</span><strong class="detail-value" style="white-space:pre-wrap;"><%= msg.message %></strong></p>
                        </div>
                    </section>
                <% }) %>
            <% } %>
        </div>
    </div>

    <script src="/js/profile-role-styles.js"></script>
    <script src="/js/darkmode.js"></script>
    <script src="/js/translate.js"></script>
    <script src="/js/icons.js"></script>
</body>
</html>