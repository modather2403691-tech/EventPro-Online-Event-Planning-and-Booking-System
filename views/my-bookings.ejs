<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - My Bookings</title>

  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
</head>
<body class="client-dashboard-page">

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="sidebar-profile">
        <img src="<%= photo ? photo : '/images/my-photo.jpg' %>" alt="Profile">
        <div>
          <h3><%= name %></h3>
          <p>Client</p>
        </div>
      </div>

      <h2>Client Panel</h2>
      <ul>
        <li><a href="/client-dashboard">My Dashboard</a></li>
        <li><a href="/my-bookings" class="active">My Bookings</a></li>
        <li><a href="/client-profile">Profile</a></li>
        <li><a href="/client-index">Back to Home</a></li>
      </ul>
    </aside>

    <div class="dashboard-content">
      <h1>My Bookings</h1>
      <p class="dashboard-subtitle">
        View all your booked events, dates, costs, and current status.
      </p>

     <section class="dashboard-section">
  <div class="booking-cards-grid">

    <div class="booking-card">
      <div class="booking-card-top">
        <div>
          <p class="booking-id">Booking ID: B001</p>
          <h3>Wedding Package</h3>
        </div>
        <span class="booking-status confirmed">Confirmed</span>
      </div>

      <div class="booking-card-body">
        <div class="booking-info">
          <span>Event Type</span>
          <strong>Wedding</strong>
        </div>
        <div class="booking-info">
          <span>Date</span>
          <strong>2025-05-12</strong>
        </div>
        <div class="booking-info">
          <span>Total Cost</span>
          <strong>$750</strong>
        </div>
      </div>

      <div class="booking-card-actions">
        <a href="/book-event"><button>Book Again</button></a>
      </div>
    </div>

    <div class="booking-card">
      <div class="booking-card-top">
        <div>
          <p class="booking-id">Booking ID: B002</p>
          <h3>Party Package</h3>
        </div>
        <span class="booking-status pending">Pending</span>
      </div>

      <div class="booking-card-body">
        <div class="booking-info">
          <span>Event Type</span>
          <strong>Party</strong>
        </div>
        <div class="booking-info">
          <span>Date</span>
          <strong>2025-06-03</strong>
        </div>
        <div class="booking-info">
          <span>Total Cost</span>
          <strong>$550</strong>
        </div>
      </div>

      <div class="booking-card-actions">
        <a href="/book-event"><button>Book Again</button></a>
      </div>
    </div>

    <div class="booking-card">
      <div class="booking-card-top">
        <div>
          <p class="booking-id">Booking ID: B003</p>
          <h3>Birthday Package</h3>
        </div>
        <span class="booking-status approved">Approved</span>
      </div>

      <div class="booking-card-body">
        <div class="booking-info">
          <span>Event Type</span>
          <strong>Birthday</strong>
        </div>
        <div class="booking-info">
          <span>Date</span>
          <strong>2025-06-20</strong>
        </div>
        <div class="booking-info">
          <span>Total Cost</span>
          <strong>$420</strong>
        </div>
      </div>

      <div class="booking-card-actions">
        <a href="/book-event"><button>Book Again</button></a>
      </div>
    </div>

  </div>
</section>
    </div>
  </div>
  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>
</body>
</html>

