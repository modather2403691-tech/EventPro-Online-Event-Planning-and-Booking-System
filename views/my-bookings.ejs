<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - My Bookings</title>

  <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
</head>
<body class="client-dashboard-page">

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="sidebar-profile">
        <img src="<%= photo ? photo : '/images/my-photo.jpg' %>" alt="Profile">
        <div>
          <h3><%= name %></h3>
          <p>Client</p>
        </div>
      </div>

      <h2>Client Panel</h2>
      <ul>
        <li><a href="/client-dashboard">My Dashboard</a></li>
        <li><a href="/my-bookings" class="active">My Bookings</a></li>
        <li><a href="/client-profile">Profile</a></li>
        <li><a href="/client-index">Back to Home</a></li>
      </ul>
    </aside>

    <div class="dashboard-content">
      <h1>My Bookings</h1>
      <p class="dashboard-subtitle">
        View all your booked events, dates, costs, and current status.
      </p>

     <section class="dashboard-section">
  <div class="booking-cards-grid">
    <% if (bookings && bookings.length) { %>
      <% bookings.forEach(booking => { %>
        <div class="booking-card">
          <div class="booking-card-top">
            <div>
              <p class="booking-id">Booking ID: <%= booking._id.toString().slice(-6).toUpperCase() %></p>
              <h3><%= booking.eventType %></h3>
            </div>
            <span class="booking-status <%= booking.status.toLowerCase() %>"><%= booking.status %></span>
          </div>

          <div class="booking-card-body">
            <div class="booking-info">
              <span>Event Type</span>
              <strong><%= booking.eventType %></strong>
            </div>
            <div class="booking-info">
              <span>Date</span>
              <strong><%= booking.eventDate ? booking.eventDate.toISOString().slice(0, 10) : 'TBD' %></strong>
            </div>
            <div class="booking-info">
              <span>Total Cost</span>
              <strong>$<%= booking.price.toFixed(2) %></strong>
            </div>
          </div>

          <div class="booking-card-actions">
            <a href="/book-event"><button>Book Again</button></a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <p>No bookings found yet.</p>
        <a href="/client-index"><button>Book Your First Event</button></a>
      </div>
    <% } %>
  </div>
</section>
    </div>
  </div>
  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>
</body>
</html>

