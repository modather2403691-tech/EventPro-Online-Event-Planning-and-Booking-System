<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>

    <!-- نفس CSS بتاع login -->
    <link rel="stylesheet" href="/css/login&regester&contact.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/darkmode.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>

<body class="login-page forgot-page">

<div class="container">

    <!-- نفس شكل login بدون تعديل -->
    <div class="animation-side">
        <!-- لو عايزة تسيبيها فاضية عادي -->
    </div>

    <div class="form-side">

        <div class="login-box">

            <div class="logo-icon">✦</div>

            <h1>Reset Password</h1>
            <p>Enter your email and new password</p>

            <% if(error){ %>
                <div style="color:red; text-align:center; margin-bottom:10px;">
                    <%= error %>
                </div>
            <% } %>

            <form id="forgotForm" action="/forgot-password" method="POST">

    <div class="input-group">
        <label>Email</label>
        <input type="email" id="fpEmail" name="email" required>
        <span id="fpEmailError" class="error"></span>
    </div>

    <div class="input-group">
        <label>New Password</label>
        <input type="password" id="fpPassword" name="newPassword" required>
        <span id="fpPasswordError" class="error"></span>
    </div>

    <button type="submit" class="btn-login">
        Reset Password
    </button>

</form>

            <p class="footer-text">
                <a href="/login">Back to Login</a>
            </p>

        </div>

    </div>

</div>
<script src="/js/login&regester&contact.js"></script>

</body>
</html>