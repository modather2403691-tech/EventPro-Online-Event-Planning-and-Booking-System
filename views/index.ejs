<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Home</title>

 <link rel="stylesheet" href="/css/client&homepages&footer.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body>

  <header>
    <nav class="home-navbar">
      <div class="home-logo">EventPro</div>

      <ul class="home-nav-links">
        <li><a href="/login">Packages</a></li>
        <li><a href="/login">Book Event</a></li>
        <li><a href="/login">Dashboard</a></li>
        <li><a href="/login">Sign In</a></li>
      </ul>

      <div class="home-nav-actions">
        <a href="/register" class="home-outline-btn">Sign Up</a>
      </div>
    </nav>
  </header>

  <main class="home-main">
    <section class="hero-modern">
      <div class="hero-left">
        <h1>Plan better events with EventPro</h1>
        <p class="hero-subtitle">
          Designed for smooth event planning, online booking, and easy management.
        </p>

        <ul class="hero-points">
          <li>Find and book the right event package faster</li>
          <li>Choose services like catering, decoration, and photography</li>
          <li>Manage bookings through client, organizer, and admin dashboards</li>
          <li>Track schedules, requests, and upcoming events</li>
        </ul>

        <div class="hero-buttons">
          <a href="/login" class="hero-primary-btn">Explore Packages</a>
          <a href="/login" class="hero-secondary-btn">Book Now</a>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-mockup">
          <div class="mockup-header">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="mockup-body">
            <div class="mockup-sidebar">
              <div class="mockup-line short"></div>
              <div class="mockup-line"></div>
              <div class="mockup-line"></div>
              <div class="mockup-line short"></div>
            </div>

            <div class="mockup-content">
              <div class="mockup-card large"></div>
              <div class="mockup-card-row">
                <div class="mockup-card small"></div>
                <div class="mockup-card small"></div>
              </div>
              <div class="mockup-card medium"></div>
            </div>
          </div>
        </div>

        <div class="floating-tag top-tag">Booking Requests</div>
        <div class="floating-tag middle-tag">Wedding Package</div>
        <div class="floating-badge">✓</div>
      </div>

      <div class="hero-curve"></div>
    </section>

    <section class="home-info-strip">
      <div class="info-strip-text">
        Event planning made simple — browse packages, book services, and manage events in one platform.
      </div>
      <a href="/register" class="info-strip-btn">Get Started</a>
    </section>

<section class="promo-section">
  <div class="promo-banner">
    <div class="promo-image">
    <img src="/assets/images/event-planner-banner.png"  alt="EventPro banner">
    </div>

    <div class="promo-content">
      <p class="promo-label">EVENTPRO</p>
      <h2>AI for smarter events</h2>
      <p>
        Bring together design, planning, and booking tools to help clients and organizers
        manage every event with ease.
      </p>
      <a href="/packages" class="promo-link">Learn how EventPro works</a>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="stats-container">
    <div class="stats-left">
      <h2>Your all-in-one solution for every event</h2>

      <div class="stats-grid">
        <div>
          <h3><span class="counter" data-target="8">8</span>M+</h3>
          <p>events managed</p>
        </div>

        <div>
          <h3><span class="counter" data-target="350">350</span>M+</h3>
          <p>registrations processed</p>
        </div>

        <div>
          <h3><span class="counter" data-target="1000">1K</span>+</h3>
          <p>partners globally</p>
        </div>

        <div>
          <h3><span class="counter" data-target="24">24</span>/7</h3>
          <p>customer support</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trusted-section">
  <h2>Trusted by top organizations</h2>

  <div class="logos">
  <img src="/assets/images/zoom.png" alt="Zoom">
  <img src="/assets/images/reuters.png"alt="Reuters">
  <img src="/assets/images/sony.png" alt="Sony">
  <img src="/assets/images/okta.png" alt="Okta">
  <img src="/assets/images/merck.png" alt="Merck">
  <img src="/assets/images/wrike.png" alt="Wrike">
    
  </div>
</section>

 

    <section class="events-section">
  <h2>Explore Events</h2>

  <div class="events-grid">
    <% if (typeof events !== 'undefined' && events && events.length) { %>
      <% events.forEach(event => { %>
        <div class="event-card">
          <img src="<%= event.image ? event.image : '/images/event1.jpg' %>" alt="Event">
          <h3><%= event.title %></h3>
          <p><%= event.date ? event.date.toISOString().slice(0, 10) : 'Date TBD' %></p>
          <p><%= event.location %></p>
          <a href="/login"><button>Join Event</button></a>
        </div>
      <% }) %>
    <% } else { %>
      <p class="muted">No events available yet. Sign in to create or book events.</p>
    <% } %>
  </div>
</section>
  </main>

 <footer class="main-footer">

  <div class="footer-top">
    <h2 class="footer-logo">EventPro</h2>
    <p class="footer-tagline">Design unforgettable celebrations with smart planning, expert support, and creative packages tailored for every moment.</p>
  </div>

  <div class="footer-links">

    <div>
      <h4>About</h4>
      <ul>
        <li><a href="/about#team">Our Team</a></li>
        <li><a href="/about#careers">Careers</a></li>
        <li><a href="/about#partners">Partners</a></li>
      </ul>
    </div>

    

    <div>
      <h4>Resources</h4>
      <ul>
        <li><a href="/resources#blog">Blog</a></li>
        <li><a href="/resources#case-studies">Case Studies</a></li>
        <li><a href="/resources#guides">Guides</a></li>
      </ul>
    </div>

    <div>
      <h4>Support</h4>
      <ul>
        <li><a href="/help-center">Help Center</a></li>
        <li><a href="/security">Security</a></li>
        <li><a href="/contact">Contact Support</a></li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© 2026 EventPro. All rights reserved.</p>
  </div>
<div class="footer-social">
  <span>🌐</span>
  <span>📘</span>
  <span>🐦</span>
  <span>▶️</span>
</div>
</footer>
<script src="/js/darkmode.js"></script>
<script src="/js/client&homepages&footer.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

