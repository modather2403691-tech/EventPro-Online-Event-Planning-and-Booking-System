<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Register</title>
  


 <link rel="stylesheet" href="/css/login&regester&contact.css">
<link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/css/darkmode.css">

<script src="/js/login&regester&contact.js"></script>
<script src="/js/darkmode.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="auth-page">

<header>
  <nav class="navbar">
    <div class="logo">Event pro</div>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/login">Login</a></li>      
    
    </ul>
  </nav>
</header>

<main>
  <h1>Register</h1>
  <p class="register-subtitle">Create your account to get started</p>
  <% if (typeof error !== 'undefined') { %>
      <div style="color: red; text-align: center; font-weight: bold; margin-bottom: 15px;">
          <%= error %>
      </div>
  <% } %>

  <div class="form-container">
<form id="registerForm" action="/register" method="POST">

  
  <div>
    <label>Full Name</label>
    <input type="text" name="name" id="name" placeholder="Enter your full name" required>
    <span id="nameError" class="error" style="color: red; font-size: 12px;"></span> 
  </div>

  <div>
    <label>Email</label>
    <input type="email" name="email" id="email" placeholder="Enter your email" required>
    <span id="emailError" class="error" style="color: red; font-size: 12px;"></span>
  </div>

  <div>
    <label>Date of Birth</label>
    <input type="date" name="dob" id="dob" required>
    <span id="dobError" class="error" style="color: red; font-size: 12px;"></span>
  </div>

  <div>
    <label>Password</label>
    <input type="password" name="password" id="password" placeholder="Enter your password" required>
    <span id="passwordError" class="error" style="color: red; font-size: 12px;"></span>
  </div>

  <div>
    <label>Confirm Password</label>
    <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm your password" required>
    <span id="confirmPasswordError" class="error" style="color: red; font-size: 12px;"></span>
  </div>

  <div>
    <label>Phone</label>
    <input type="text" name="phone" id="phone" maxlength="11" placeholder="01xxxxxxxxx" required>
    <span id="phoneError" class="error" style="color: red; font-size: 12px;"></span>
  </div>

  <div>
    <label>Role</label>
    <select name="role" id="roles" required>
        <option value="Client">Client</option>
        <option value="organizer">organizer</option>
    </select>
    <span id="roleError" class="error"></span>
</div>

  <button type="submit">Register</button>
</form>
  </div>
</main>

<footer class="footer">
  <p>&copy; 2026 EventPro</p>
</footer>
  <script src="/js/login&regester&contact.js"></script>
<script src="/js/darkmode.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

