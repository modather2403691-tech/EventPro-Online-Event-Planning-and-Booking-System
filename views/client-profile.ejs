<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Client Profile</title>
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="profile-dashboard-page">

  <div class="dashboard-container">
    <%- include('partials/sidebar', { role: 'client', active: 'profile', name: name, photo: photo }) %>

    <div class="dashboard-content">
      <div class="profile-header">
        <div>
          <h1>My Profile</h1>
          <p>Welcome to your EventPro client portal.</p>
        </div>
      </div>

      <div class="profile-layout">
        <div class="profile-main-card">

          <!-- Clickable photo — opens file picker on click -->
          <div class="photo-wrapper" id="photoWrapper" title="Click to change photo">
            <img id="profilePhoto"
                 src="<%= photo ? photo : '/images/my-photo.jpg' %>"
                 alt="Profile Photo">
            <div class="photo-overlay">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Change Photo
            </div>
          </div>

          <!-- Hidden file input -->
          <input type="file" id="photoInput" accept="image/jpeg,image/png,image/webp,image/gif">

          <!-- Upload status -->
          <div id="uploadStatus"></div>

          <h3>My profile</h3>

          <div class="profile-info-list">
            <div class="profile-info-row">
              <span>Full Name</span>
              <strong id="displayName"><%= name %></strong>
              <input id="inputName" class="profile-edit-input" type="text" value="<%= name %>" style="display:none">
            </div>
            <div class="profile-info-row">
              <span>Phone</span>
              <strong id="displayPhone"><%= phone %></strong>
              <input id="inputPhone" class="profile-edit-input" type="text" value="<%= phone %>" style="display:none">
            </div>
            <div class="profile-info-row">
              <span>Email</span>
              <strong><%= email %></strong>
            </div>
            <div class="profile-info-row">
              <span>Member Since</span>
              <strong><%= memberSince %></strong>
            </div>
          </div>

          <div id="profileEditStatus"></div>

          <div class="profile-action-row">
            <button class="profile-edit-toggle-btn" id="profileEditBtn">Edit Profile</button>
            <button class="profile-save-data-btn" id="profileSaveBtn" style="display:none">Save Changes</button>
            <button class="profile-cancel-btn" id="profileCancelBtn" style="display:none">Cancel</button>
          </div>

          <div class="profile-toggle-row">
            <span>Booking alerts activation</span>
            <span class="toggle-dot"></span>
          </div>

        </div>

        <div class="profile-side-column">
          <div class="profile-box">
            <div class="profile-box-header">
              <h3>Change Password</h3>
            </div>
            <div class="profile-box-body">
              <div class="form-row">
                <label for="currentPassword">Current Password</label>
                <input type="password" id="currentPassword" placeholder="Enter current password" autocomplete="current-password">
                <span id="currentPasswordError" class="error-msg"></span>
              </div>
              <div class="form-row">
                <label for="newPassword">New Password</label>
                <input type="password" id="newPassword" placeholder="New password" autocomplete="new-password">
                <span id="newPasswordError" class="error-msg"></span>
              </div>
              <div class="form-row">
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" id="confirmPassword" placeholder="Confirm new password" autocomplete="new-password">
                <span id="confirmPasswordError" class="error-msg"></span>
              </div>
              <button class="profile-save-data-btn" id="changePasswordBtn" type="button">Update Password</button>
              <div id="passwordChangeStatus" style="margin-top:10px;font-size:13px;min-height:18px;"></div>
            </div>
          </div>

          <div class="profile-box">
            <div class="profile-box-header">
              <h3>My EventPro account</h3>
            </div>

            <div id="accountStatus" style="font-size:13px;font-weight:500;min-height:16px;margin-bottom:10px;text-align:center;"></div>

            <div style="text-align:center;">
              <button class="delete-account-btn" id="deleteAccountBtn">Delete Account</button>
            </div>
          </div>

          <!-- Delete confirmation modal -->
          <div id="deleteModal" class="delete-modal-overlay" style="display:none;">
            <div class="delete-modal-box">
              <h3>Delete Account</h3>
              <p>This will permanently delete your account and all your bookings. This action <strong>cannot be undone</strong>.</p>
              <p>Enter your password to confirm.</p>
              <div class="form-row" style="margin-top:12px;">
                <input type="password" id="deletePassword" placeholder="Enter password to delete account" autocomplete="current-password">
                <span id="deletePasswordError" class="error-msg"></span>
              </div>
              <div class="delete-modal-actions">
                <button class="delete-modal-confirm" id="deleteConfirmBtn">Yes, Delete My Account</button>
                <button class="delete-modal-cancel" id="deleteCancelBtn">Cancel</button>
              </div>
            </div>
          </div>

          <div class="profile-box">
            <div class="profile-box-header">
              <h3>My activity</h3>
              <a href="/my-bookings" class="small-edit-btn">View all</a>
            </div>

            <% if (bookings && bookings.length > 0) { %>
              <% bookings.forEach(b => {
                const isPaid      = b.status === 'Confirmed';
                const isPending   = b.status === 'Pending';
                const dotClass    = isPaid ? 'green' : 'pink';
                const btnClass    = isPaid ? 'green-btn' : 'pink-btn';
                const label       = isPaid ? 'Paid' : b.status;
              %>
              <div class="bill-row">
                <span class="bill-dot <%= dotClass %>"></span>
                <span><%= b.eventType %></span>
                <button class="mini-status <%= btnClass %>"><%= label %></button>
              </div>
              <% }) %>
            <% } else { %>
              <p style="color:#888; font-size:14px; text-align:center; padding:12px 0;">
                No bookings yet. <a href="/packages" style="color:#2563eb;">Browse packages</a>
              </p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/darkmode.js"></script>
  <script src="/js/client-profile.js"></script>
  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>
