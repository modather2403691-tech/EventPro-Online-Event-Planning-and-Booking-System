<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Contact</title>

  <link rel="stylesheet" href="/css/login&regester&contact.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
</head>
<body class="contact-page">

<header>
  <nav class="navbar">
    <div class="logo">EventPro</div>
    <ul class="nav-links">
      <li><a href="/index">Home</a></li>
      <li><a href="/packages">Packages</a></li>
      
    </ul>
  </nav>
</header>

<main>
  <h1>Contact Us</h1>
  <p style="text-align:center; color:white; margin-bottom: 25px;">
    Please fill in the form below and we will get back to you as soon as possible.
  </p>

  <div class="form-container">
    <form id="contactForm">
      <div>
        <label>Name</label>
      <input type="text" id="contactName" placeholder="Enter your name">
    <small class="error" id="contactNameError"></small>
      </div>

      <div>
        <label>Email</label>
      <input type="email" id="contactEmail" placeholder="Enter your email">
    <small class="error" id="contactEmailError"></small>
      </div>

      <div>
        <label>Message</label>
         <textarea id="contactMessage" rows="4" placeholder="Write your message..."></textarea>
    <small class="error" id="contactMessageError"></small>
  
      </div>

      <button type="submit">Send Message</button>
    </form>
  </div>
</main>
<footer class="footer">
  <p>&copy; 2026 EventPro</p>
</footer>

  <script src="/js/login&regester&contact.js"></script>
  <script src="/js/darkmode.js"></script>
</body>
</html>

