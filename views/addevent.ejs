<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Dashboard</title>
    <link rel="stylesheet" href="/css/organizer.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>

<body class="organizer-page add-event-page">
  <div class="dashboard-container">
    <%- include('partials/sidebar', { role: 'organizer', active: 'addevent', name: name, photo: photo }) %>

    <div class="dashboard-content">
      <h1>Create Event</h1>

      <form id="form-box">

        <label class="label">Event Image:</label>
        <input type="file" id="image" class="input-field" accept="image/*">
        <span id="imageError" class="error"></span>

        <label class="label">Title:</label>
        <input type="text" id="title" class="input-field" placeholder="Enter event title" required>
        <span id="titleError" class="error"></span>

        <label class="label">Category:</label>
        <select id="category" class="input-field">
          <option value="party">Party</option>
          <option value="corporate">Corporate</option>
          <option value="wedding">Wedding</option>
          <option value="birthday">Birthday</option>
          <option value="other">Other</option>
        </select>
        <span id="categoryError" class="error"></span>

        <label class="label">Date of Event:</label>
        <input type="date" id="date" class="input-field" required>
        <span id="dateError" class="error"></span>

        <label class="label">Capacity:</label>
        <input type="number" id="capacity" class="input-field" min="1" placeholder="Enter number of people" required>
        <span id="capacityError" class="error"></span>

        <label class="label">Price ($):</label>
        <input type="number" id="price" class="input-field" min="0" placeholder="Ticket price per guest" required>
        <span id="priceError" class="error"></span>

        <label class="label">Location:</label>
        <input type="text" id="location" class="input-field" placeholder="Enter location" required>
        <span id="locationError" class="error"></span>

        <label class="label">Rules:</label>
        <textarea id="rules" class="input-field" placeholder="Enter rules here..."></textarea>

        <button id="submit-btn">Submit</button>

      </form>
    </div>
  </div>

  <script src="/js/organizer.js"></script>
  <script src="/js/profile-role-styles.js"></script>
  <script src="/js/darkmode.js"></script>

  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>
