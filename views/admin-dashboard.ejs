<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventPro - Admin Dashboard</title>

  <link rel="stylesheet" href="/css/Admin.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body class="admin-page">
  <% const dashboardStats = typeof stats !== 'undefined' ? stats : { activeUsers: 0, newBookings: 0, pendingApprovals: 0 }; %>
  <% const recentActivity = Array.isArray(activity) ? activity : []; %>
  <% const lastUpdated = typeof updatedAt !== 'undefined' ? updatedAt : 'N/A'; %>
  <% const adminName = typeof name !== 'undefined' && name ? name : 'Admin'; %>
  
  <div class="dashboard-container" id="dashboardContainer">
    <aside class="sidebar" id="sidebar">
      <div class="brand-wrapper" id="brandLogo">
        <div class="brand-mark"><%= adminName.charAt(0).toUpperCase() %></div>
        <div class="brand-text">
          <span class="brand-name"><%= adminName %></span>
          <span class="brand-subtitle">Admin</span>
        </div>
      </div>
      <nav aria-label="Admin navigation" id="adminNav">
        <h2 id="sidebarTitle">Admin Panel</h2>
        <ul id="sidebarMenu">
          <li id="sidebarItemDashboard"><a id="navDashboard" href="/admin-dashboard">Dashboard</a></li>
          <li id="sidebarItemUsers"><a id="navUsers" href="/manage-users">Manage Users</a></li>
          <li id="sidebarItemClientReservations"><a id="navClientReservations" href="/client-reservation">Client Reservation</a></li>
          <li id="sidebarItemOrganizerEvents"><a id="navOrganizerEvents" href="/organizer-event">Organizer Event</a></li>
          <li id="sidebarItemMessages"><a id="navMessages" href="/admin/messages">Messages</a></li>
          <li id="sidebarItemReports"><a id="navReports" href="/reports">Reports</a></li>
          <li id="sidebarItemHome"><a id="navHome" href="/admin-index">Back to Home</a></li>
        </ul>
      </nav>
    </aside>

    <main class="dashboard-content" id="dashboardContent" role="main">
      <div class="top-bar" id="topBar">
        <div class="page-heading" id="pageHeading">
          <h1 id="pageTitle">Admin Dashboard</h1>
          <p class="page-description" id="pageDescription">Monitor platform health, booking flow, and team activity from a unified control center.</p>
        </div>
        <div class="page-meta" id="pageMeta">
          <span id="metaUpdated">Last updated <%= lastUpdated %></span>
        </div>
      </div>

      <div class="dashboard-actions" id="dashboardActions">
        <button id="btnGenerateReport" type="button" data-target="/reports">Generate report</button>
        <button id="btnExportCsv" type="button" data-target="/admin-dashboard/export-csv">Export CSV</button>
      </div>

      <div class="cards" id="statsGrid">
        <div class="card" id="cardUsers">
          <h3 id="cardUsersTitle">Active Users</h3>
          <p id="cardUsersValue"><%= dashboardStats.activeUsers %></p>
          <span class="card-note" id="cardUsersNote">+4.2% vs last week</span>
        </div>

        <div class="card" id="cardBookings">
          <h3 id="cardBookingsTitle">New Bookings</h3>
          <p id="cardBookingsValue"><%= dashboardStats.newBookings %></p>
          <span class="card-note" id="cardBookingsNote">Updated hourly</span>
        </div>

        <div class="card" id="cardPending">
          <h3 id="cardPendingTitle">Pending Approvals</h3>
          <p id="cardPendingValue"><%= dashboardStats.pendingApprovals %></p>
          <span class="card-note" id="cardPendingNote">Awaiting review</span>
        </div>
      </div>

      <section class="dashboard-section" id="activitySection">
        <div class="activity-header" id="activityHeader">
          <div>
            <h2 id="activityTitle">Recent System Activity</h2>
            <p class="section-description" id="activityDescription">Latest actions taken by staff and clients across bookings, user management and reporting.</p>
          </div>
          <div class="activity-controls" id="activityTools">
            <label class="sr-only" for="activitySearch">Search activity</label>
            <input id="activitySearch" type="search" placeholder="Search activity..." autocomplete="off">
            <label class="sr-only" for="activityFilterRole">Filter by role</label>
            <select id="activityFilterRole" aria-label="Filter by role">
              <option value="">All roles</option>
              <option value="Client">Client</option>
              <option value="Organizer">Organizer</option>
              <option value="Admin">Admin</option>
            </select>
          </div>
        </div>

        <table class="dashboard-table" id="activityTable">
          <thead>
            <tr id="activityHeaderRow">
              <th id="colActivityId">Activity ID</th>
              <th id="colUser">User</th>
              <th id="colRole">Role</th>
              <th id="colAction">Action</th>
              <th id="colDate">Date</th>
            </tr>
          </thead>
          <tbody id="activityTableBody">
            <% if (recentActivity.length > 0) { %>
              <% recentActivity.forEach(item => { %>
                <tr>
                  <td><%= item.activityId %></td>
                  <td><%= item.user %></td>
                  <td><%= item.role %></td>
                  <td><%= item.action %></td>
                  <td><%= item.dateLabel %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align:center; padding:20px;">No recent activity found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </section>
    </div>
  </div>

  <script src="/js/admin.js"></script>
  <script src="/js/darkmode.js"></script>

  <script src="/js/translate.js"></script>
  <script src="/js/icons.js"></script>
</body>
</html>

